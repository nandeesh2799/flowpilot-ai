# FlowPilot AI — Intelligent Support Workflow Copilot
# Environment Configuration Template

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini API Configuration (Runtime AI Provider)
# Leave blank to run in deterministic offline Demo Mode
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Guided Demo Mode Override
# Set to "true" to force deterministic demo fallback, or "false" to require live AI
NEXT_PUBLIC_DEMO_MODE="true"

# Supabase Persistence Configuration (Optional - Defaults to local relational storage)
# When configured, tickets, AI analyses, reviews, and audit logs are stored in Supabase PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Direct PostgreSQL Connection String (if running standalone Postgres)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowpilot"
